NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/scorekings_integration
# Local development key. Partner keys can also be stored as SHA-256 hashes in MongoDB.
SCOREKINGS_API_KEY=replace-with-a-local-development-key
SCOREKINGS_DEMO_PARTNER_ID=demo-partner
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
